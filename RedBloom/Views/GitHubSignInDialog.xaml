<Window x:Class="RedBloom.Views.GitHubSignInDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Divider}"
            BorderThickness="1" CornerRadius="9" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{DynamicResource L_GhSignInTitle}" Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{DynamicResource UiFont}" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="{DynamicResource L_GhDeviceIntro}" Foreground="{DynamicResource TextMuted}"
                       FontFamily="{DynamicResource UiFont}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14" />

            <!-- the user code -->
            <Border x:Name="CodePanel" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="8" Padding="10,12" Margin="0,0,0,14" Visibility="Collapsed">
                <TextBox x:Name="CodeBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextPrimary}" HorizontalContentAlignment="Center"
                         HorizontalAlignment="Center" FontFamily="Cascadia Mono, Consolas, monospace"
                         FontSize="26" FontWeight="SemiBold" TextAlignment="Center" IsTabStop="False" />
            </Border>

            <Button x:Name="OpenButton" Content="{DynamicResource L_GhDeviceOpen}" Style="{StaticResource AccentButton}"
                    Padding="14,8" HorizontalAlignment="Stretch" Click="Open_Click"
                    Visibility="Collapsed" Margin="0,0,0,12" />

            <StackPanel x:Name="StatusRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,2">
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" FontFamily="{DynamicResource UiFont}"
                           FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#FF6B74" FontFamily="{DynamicResource UiFont}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CloseButton" Content="{DynamicResource L_Cancel}" Style="{StaticResource GhostButton}"
                        Padding="14,5" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
