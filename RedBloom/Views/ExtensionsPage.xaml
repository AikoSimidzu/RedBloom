<UserControl x:Class="RedBloom.Views.ExtensionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="SectionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <DataTemplate x:Key="ExtensionCard">
            <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,10">
                <Grid ColumnDefinitions="34,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="19"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,0,0" />

                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}"
                                       FontFamily="{DynamicResource UiFont}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource SurfaceRaised}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextFaint}"
                                           FontFamily="{DynamicResource UiFont}" FontSize="9.5" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}"
                                   FontFamily="{DynamicResource UiFont}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <CheckBox Content="{DynamicResource L_ExtEnabled}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextMuted}" FontFamily="{DynamicResource UiFont}" FontSize="11.5"
                                  HorizontalAlignment="Right" />
                        <Button Content="{DynamicResource L_ExtOpen}" Style="{StaticResource AccentButton}" Padding="16,5"
                                Margin="0,9,0,0" HorizontalAlignment="Right" Tag="{Binding}" Click="Open_Click"
                                IsEnabled="{Binding Enabled}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,22,28,14">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource L_Extensions}" Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{DynamicResource UiFont}" FontSize="19" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource L_ExtensionsNote}" Foreground="{DynamicResource TextFaint}"
                           FontFamily="{DynamicResource UiFont}" FontSize="11.5" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource L_ExtDocs}" Click="Docs_Click" Margin="0,0,8,0" />
                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource L_ExtFolder}" Click="Folder_Click" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,28">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                <ItemsControl x:Name="ExtList" ItemTemplate="{StaticResource ExtensionCard}" />
                <TextBlock x:Name="EmptyNote" Text="{DynamicResource L_ExtNone}" Foreground="{DynamicResource TextFaint}"
                           FontFamily="{DynamicResource UiFont}" FontSize="12" Margin="2,6,0,0" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
