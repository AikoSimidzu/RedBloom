<Window x:Class="RedBloom.Views.SessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SSH session"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Chrome}"
            BorderBrush="{DynamicResource Divider}"
            BorderThickness="1"
            CornerRadius="9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- header -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  ColumnDefinitions="*,Auto">
                <TextBlock x:Name="HeaderText"
                           Grid.Column="0"
                           Text="New SSH session"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="20,16,0,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,10,0">
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE77F;"
                            Width="28" Height="28"
                            Margin="0,0,2,0"
                            Click="PasteSshCommand_Click"
                            ToolTip="Fill this in from an ssh command on the clipboard" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE711;"
                            Width="28" Height="28"
                            Click="Cancel_Click" />
                </StackPanel>
            </Grid>

            <!-- fields -->
            <StackPanel Grid.Row="1" Margin="20,14,20,0">

                <TextBlock Text="NAME" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" />

                <Grid ColumnDefinitions="*,10,90" Margin="0,12,0,0">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HOST" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="HostBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PORT" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PortBox" MaxLength="5" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <TextBox x:Name="UserBox" />

                <TextBlock Text="AUTHENTICATION" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PasswordAuth"
                                 Style="{StaticResource SegmentedRadio}"
                                 Content="Password"
                                 IsChecked="True"
                                 Checked="AuthKind_Changed"
                                 Margin="0,0,8,0" />
                    <RadioButton x:Name="KeyAuth"
                                 Style="{StaticResource SegmentedRadio}"
                                 Content="Private key"
                                 Checked="AuthKind_Changed" />
                </StackPanel>

                <!-- password branch -->
                <StackPanel x:Name="PasswordPanel" Margin="0,14,0,0">
                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordField" />
                    <TextBlock Text="Stored encrypted with Windows DPAPI under your account. Leave empty to be asked on each connect."
                               Foreground="{DynamicResource TextFaint}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               Margin="1,6,0,0" />
                </StackPanel>

                <!-- key branch -->
                <StackPanel x:Name="KeyPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="PRIVATE KEY FILE" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,8,Auto">
                        <TextBox x:Name="KeyPathBox" Grid.Column="0" />
                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Content="Browse"
                                Padding="12,6"
                                Click="Browse_Click" />
                    </Grid>
                    <TextBlock Text="PASSPHRASE" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <PasswordBox x:Name="PassphraseField" />
                </StackPanel>

                <!-- tunnels -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,6">
                    <TextBlock Grid.Column="0"
                               Text="TUNNELS"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"
                               Margin="0" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Content="&#xE710;"
                            Width="22" Height="22"
                            Click="AddForward_Click"
                            ToolTip="Add a tunnel" />
                </Grid>

                <ItemsControl x:Name="ForwardList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Divider}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8,6"
                                    Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                                    <ComboBox Grid.Column="0"
                                              Width="72"
                                              SelectedIndex="{Binding KindIndex, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              FontSize="11">
                                        <ComboBoxItem Content="-L" />
                                        <ComboBoxItem Content="-R" />
                                        <ComboBoxItem Content="-D" />
                                    </ComboBox>
                                    <TextBox Grid.Column="1"
                                             Width="62"
                                             Margin="6,0,0,0"
                                             Padding="6,4"
                                             FontSize="11"
                                             Text="{Binding BoundPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Local port to listen on" />
                                    <TextBlock Grid.Column="2"
                                               Text="→"
                                               Foreground="{DynamicResource TextFaint}"
                                               VerticalAlignment="Center"
                                               Margin="7,0"
                                               Visibility="{Binding NeedsDestination, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Grid.Column="3"
                                             Width="112"
                                             Padding="6,4"
                                             FontSize="11"
                                             Text="{Binding DestinationHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding NeedsDestination, Converter={StaticResource BoolToVis}}"
                                             ToolTip="Destination host, as the far end sees it" />
                                    <TextBox Grid.Column="4"
                                             Width="62"
                                             Margin="6,0,0,0"
                                             Padding="6,4"
                                             FontSize="11"
                                             Text="{Binding DestinationPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding NeedsDestination, Converter={StaticResource BoolToVis}}"
                                             ToolTip="Destination port" />
                                    <Button Grid.Column="6"
                                            Style="{StaticResource IconButton}"
                                            Content="&#xE74D;"
                                            Width="22" Height="22"
                                            Click="RemoveForward_Click"
                                            Tag="{Binding}"
                                            ToolTip="Remove" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- connection behaviour -->
                <TextBlock Text="CONNECTION" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                <CheckBox x:Name="AutoReconnectBox"
                          Content="Reconnect automatically if the connection drops" />
                <TextBlock Text="Retries with a growing delay, up to five times. A session that stays up for a minute resets the count."
                           Foreground="{DynamicResource TextFaint}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="10.5"
                           TextWrapping="Wrap"
                           Margin="25,5,0,0" />

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource Accent}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="1,12,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- footer -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,20,20,18">
                <Button Style="{StaticResource GhostButton}"
                        Content="Cancel"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Style="{StaticResource AccentButton}"
                        Content="Save"
                        IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

