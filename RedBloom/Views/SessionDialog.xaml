<Window x:Class="RedBloom.Views.SessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RedBloom"
        mc:Ignorable="d"
        Title="SSH session"
        Width="420"
        SizeToContent="Height"
        MaxHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Chrome}"
            BorderBrush="{DynamicResource Divider}"
            BorderThickness="1"
            CornerRadius="9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- header -->
            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  ColumnDefinitions="*,Auto">
                <TextBlock x:Name="HeaderText"
                           Grid.Column="0"
                           Text="{DynamicResource L_NewSshSessionHeader}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="20,16,0,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,10,0">
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE77F;"
                            Width="28" Height="28"
                            Margin="0,0,2,0"
                            Click="PasteSshCommand_Click"
                            ToolTip="{DynamicResource L_PasteSshTip}" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE711;"
                            Width="28" Height="28"
                            Click="Cancel_Click" />
                </StackPanel>
            </Grid>

            <!-- fields — scrollable so the whole form stays a sensible height -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
            <StackPanel Margin="20,14,16,0">

                <TextBlock Text="{DynamicResource L_FieldName}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" />

                <Grid ColumnDefinitions="*,10,90" Margin="0,12,0,0">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource L_FieldHost}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="HostBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource L_FieldPort}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PortBox" MaxLength="5" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource L_FieldUsername}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <TextBox x:Name="UserBox" />

                <TextBlock Text="{DynamicResource L_FieldAuth}" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PasswordAuth"
                                 Style="{StaticResource SegmentedRadio}"
                                 Content="{DynamicResource L_AuthPassword}"
                                 IsChecked="True"
                                 Checked="AuthKind_Changed"
                                 Margin="0,0,8,0" />
                    <RadioButton x:Name="KeyAuth"
                                 Style="{StaticResource SegmentedRadio}"
                                 Content="{DynamicResource L_AuthPrivateKey}"
                                 Checked="AuthKind_Changed" />
                </StackPanel>

                <!-- password branch -->
                <StackPanel x:Name="PasswordPanel" Margin="0,14,0,0">
                    <TextBlock Text="{DynamicResource L_FieldPassword}" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PasswordField" />
                    <TextBlock Text="{DynamicResource L_PasswordDpapiNote}"
                               Foreground="{DynamicResource TextFaint}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               Margin="1,6,0,0" />
                </StackPanel>

                <!-- key branch -->
                <StackPanel x:Name="KeyPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource L_FieldKeyFile}" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,8,Auto">
                        <TextBox x:Name="KeyPathBox" Grid.Column="0" />
                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Content="{DynamicResource L_Browse}"
                                Padding="12,6"
                                Click="Browse_Click" />
                    </Grid>
                    <TextBlock Text="{DynamicResource L_FieldPassphrase}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <PasswordBox x:Name="PassphraseField" />
                </StackPanel>

                <!-- tunnels -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,18,0,6">
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L_FieldTunnels}"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"
                               Margin="0" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Content="&#xE710;"
                            Width="22" Height="22"
                            Click="AddForward_Click"
                            ToolTip="{DynamicResource L_AddTunnelTip}" />
                </Grid>

                <ItemsControl x:Name="ForwardList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource Divider}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8,6"
                                    Margin="0,0,0,5">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                                    <ComboBox Grid.Column="0"
                                              Width="72"
                                              SelectedIndex="{Binding KindIndex, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              FontSize="11">
                                        <ComboBoxItem Content="-L" />
                                        <ComboBoxItem Content="-R" />
                                        <ComboBoxItem Content="-D" />
                                    </ComboBox>
                                    <TextBox Grid.Column="1"
                                             Width="62"
                                             Margin="6,0,0,0"
                                             Padding="6,4"
                                             FontSize="11"
                                             Text="{Binding BoundPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{DynamicResource L_TunnelLocalPortTip}" />
                                    <TextBlock Grid.Column="2"
                                               Text="→"
                                               Foreground="{DynamicResource TextFaint}"
                                               VerticalAlignment="Center"
                                               Margin="7,0"
                                               Visibility="{Binding NeedsDestination, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Grid.Column="3"
                                             Width="112"
                                             Padding="6,4"
                                             FontSize="11"
                                             Text="{Binding DestinationHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding NeedsDestination, Converter={StaticResource BoolToVis}}"
                                             ToolTip="{DynamicResource L_TunnelDestHostTip}" />
                                    <TextBox Grid.Column="4"
                                             Width="62"
                                             Margin="6,0,0,0"
                                             Padding="6,4"
                                             FontSize="11"
                                             Text="{Binding DestinationPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding NeedsDestination, Converter={StaticResource BoolToVis}}"
                                             ToolTip="{DynamicResource L_TunnelDestPortTip}" />
                                    <Button Grid.Column="6"
                                            Style="{StaticResource IconButton}"
                                            Content="&#xE74D;"
                                            Width="22" Height="22"
                                            Click="RemoveForward_Click"
                                            Tag="{Binding}"
                                            ToolTip="{DynamicResource L_Remove}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- connection behaviour -->
                <TextBlock Text="{DynamicResource L_FieldConnection}" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                <CheckBox x:Name="AutoReconnectBox"
                          Content="{DynamicResource L_AutoReconnect}" />
                <TextBlock Text="{DynamicResource L_AutoReconnectNote}"
                           Foreground="{DynamicResource TextFaint}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="10.5"
                           TextWrapping="Wrap"
                           Margin="25,5,0,0" />

                <!-- tab card look; bound to the draft session's TabCard in code -->
                <TextBlock Text="{DynamicResource L_TabCard}" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                <StackPanel x:Name="CardPanel">
                    <Grid ColumnDefinitions="90,Auto,10,*,6,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_CardColor}" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0" />
                        <Border Grid.Column="1" Width="28" Height="24" CornerRadius="5"
                                Cursor="Hand"
                                MouseLeftButtonUp="CardSwatch_Click"
                                Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11.5" Padding="7,4" />
                        <TextBox Grid.Column="5" x:Name="CardGlyphBox" Width="52"
                                 Text="{Binding Glyph, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource IconFont}" FontSize="12" Padding="6,4"
                                 ToolTip="{DynamicResource L_CardIcon}" />
                    </Grid>

                    <Grid ColumnDefinitions="90,*,10,50" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_CardOpacity}" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Opacity, StringFormat={}{0:P0}}" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0" />
                    </Grid>
                    <Grid ColumnDefinitions="90,*,10,50" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_CardBlur}" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="60" Value="{Binding Blur, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Blur, StringFormat={}{0:0}}" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0" />
                    </Grid>

                    <Grid ColumnDefinitions="*,8,Auto,6,Auto" Margin="0,0,0,7">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11.5" Padding="7,5" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                Content="{DynamicResource L_Browse}" Padding="12,6" Click="BrowseCardImage_Click" />
                        <Button Grid.Column="4" Style="{StaticResource GhostButton}"
                                Content="{DynamicResource L_Clear}" Padding="12,6" Click="ClearCardImage_Click" />
                    </Grid>
                    <Grid ColumnDefinitions="90,180">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_Fit}" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0" />
                        <ComboBox Grid.Column="1" x:Name="CardFitBox" SelectionChanged="CardFit_Changed">
                            <ComboBoxItem Content="{DynamicResource L_FitFillCrop}" />
                            <ComboBoxItem Content="{DynamicResource L_FitInside}" />
                            <ComboBoxItem Content="{DynamicResource L_FitStretch}" />
                            <ComboBoxItem Content="{DynamicResource L_FitOriginal}" />
                        </ComboBox>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource Accent}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="1,12,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
            </ScrollViewer>

            <!-- footer -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,20,20,18">
                <Button Style="{StaticResource GhostButton}"
                        Content="{DynamicResource L_Cancel}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Style="{StaticResource AccentButton}"
                        Content="{DynamicResource L_Save}"
                        IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

