<Window x:Class="RedBloom.Views.PublishDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publish"
        Width="480" Height="612"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource Chrome}" BorderBrush="{DynamicResource Divider}"
            BorderThickness="1" CornerRadius="9" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <Grid Margin="22,20,22,18" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource UiFont}"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- first publish: name + visibility -->
            <StackPanel Grid.Row="1" x:Name="NamePanel">
                <TextBlock Text="{DynamicResource L_PubName}" Foreground="{DynamicResource TextMuted}"
                           FontFamily="{DynamicResource UiFont}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" Padding="7,5" Margin="0,0,0,12" />

                <TextBlock Text="{DynamicResource L_PubVisibility}" Foreground="{DynamicResource TextMuted}"
                           FontFamily="{DynamicResource UiFont}" FontSize="12" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="PrivateBtn" Style="{StaticResource SegmentedRadio}" Content="{DynamicResource L_PubPrivate}"
                                 IsChecked="True" Margin="0,0,8,0" />
                    <RadioButton x:Name="PublicBtn" Style="{StaticResource SegmentedRadio}" Content="{DynamicResource L_PubPublic}" />
                </StackPanel>
            </StackPanel>

            <!-- update: which repo -->
            <TextBlock Grid.Row="2" x:Name="RepoText" Foreground="{DynamicResource TextMuted}"
                       FontFamily="{DynamicResource UiFont}" FontSize="12.5" Margin="0,0,0,12" Visibility="Collapsed" />

            <StackPanel Grid.Row="3">
                <CheckBox x:Name="ImportAllBox" IsChecked="True" Content="{DynamicResource L_PubImportAll}"
                          Foreground="{DynamicResource TextPrimary}" FontFamily="{DynamicResource UiFont}"
                          FontSize="12.5" Margin="0,0,0,2" />
                <TextBlock x:Name="ImportHint" Text="{DynamicResource L_PubImportAllHint}" Foreground="{DynamicResource TextFaint}"
                           FontFamily="{DynamicResource UiFont}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,12" />

                <TextBlock Text="{DynamicResource L_PubMessage}" Foreground="{DynamicResource TextMuted}"
                           FontFamily="{DynamicResource UiFont}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="MessageBox" Padding="7,5" Margin="0,0,0,12" />

                <TextBlock x:Name="ChangesHeader" Foreground="{DynamicResource TextFaint}" FontFamily="{DynamicResource UiFont}"
                           FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,5" />
            </StackPanel>

            <Border Grid.Row="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="7">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,4">
                        <ItemsControl x:Name="ChangesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="22,*" Margin="2,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Code}" Foreground="{Binding Brush}"
                                                   FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{DynamicResource TextMuted}"
                                                   FontFamily="{DynamicResource UiFont}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="NoChanges" Text="{DynamicResource L_PubNoChanges}"
                               Foreground="{DynamicResource TextFaint}" FontFamily="{DynamicResource UiFont}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{DynamicResource L_Cancel}" Style="{StaticResource GhostButton}" Padding="14,5" Click="Cancel_Click" />
                <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Padding="14,5" Margin="8,0,0,0" Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
