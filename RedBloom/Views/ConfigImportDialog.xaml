<Window x:Class="RedBloom.Views.ConfigImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Import"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource Chrome}"
            BorderBrush="{DynamicResource Divider}"
            BorderThickness="1"
            CornerRadius="9"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <StackPanel Margin="20,18,20,18">
            <TextBlock Text="{DynamicResource L_AiImportTitle}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource L_AiImportNote}"
                       Foreground="{DynamicResource TextFaint}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />

            <TextBox x:Name="ConfigBox"
                     Margin="0,12,0,0"
                     Height="200"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas, monospace"
                     FontSize="11.5"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />

            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource TextMuted}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="FileButton"
                        Style="{StaticResource GhostButton}"
                        Content="{DynamicResource L_AiImportFromFile}"
                        HorizontalAlignment="Left"
                        Margin="0,0,8,0"
                        Click="FromFile_Click" />
                <Button Style="{StaticResource GhostButton}"
                        Content="{DynamicResource L_Cancel}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button x:Name="ImportButton"
                        Style="{StaticResource AccentButton}"
                        Content="{DynamicResource L_AiImportAction}"
                        IsDefault="True"
                        Click="Import_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
