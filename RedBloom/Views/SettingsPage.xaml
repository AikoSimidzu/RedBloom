<UserControl x:Class="RedBloom.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource Surface}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="SectionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- Longer Russian labels ellipsize instead of sliding under the next control. -->
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- swatch + hex field, used for every colour on the page. The label column is wide
             enough for the longer Russian names, which used to slide under the swatch. -->
        <DataTemplate x:Key="ColorRow">
            <Grid Margin="0,0,0,7" ColumnDefinitions="210,Auto,10,110">
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource RowLabel}" />
                <Border Grid.Column="1"
                        Width="30" Height="26"
                        CornerRadius="5"
                        Background="{Binding Swatch}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1" />
                <TextBox Grid.Column="3"
                         Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Cascadia Mono, Consolas, monospace"
                         FontSize="11.5"
                         Padding="7,4" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,22,28,14">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource L_Appearance}"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="19"
                           FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource L_AppearanceNote}"
                           Foreground="{DynamicResource TextFaint}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="11.5"
                           Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource GhostButton}"
                    Content="{DynamicResource L_ResetDefaults}"
                    VerticalAlignment="Center"
                    Click="Reset_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,0,28,28">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <!-- ============ language ============ -->
                <TextBlock Text="{DynamicResource L_Language}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource L_LanguageNote}" Style="{StaticResource SectionNote}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton x:Name="LangEn" Style="{StaticResource SegmentedRadio}"
                                 Content="English" Margin="0,0,8,0" Checked="Language_Changed" />
                    <RadioButton x:Name="LangRu" Style="{StaticResource SegmentedRadio}"
                                 Content="Русский" Checked="Language_Changed" />
                </StackPanel>

                <!-- ============ integration ============ -->
                <TextBlock Text="{DynamicResource L_Integration}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource L_IntegrationNote}" Style="{StaticResource SectionNote}" />
                <CheckBox x:Name="ShellIntegrationBox"
                          Content="{DynamicResource L_OpenHereToggle}"
                          Margin="0,0,0,20"
                          Checked="ShellIntegration_Changed"
                          Unchecked="ShellIntegration_Changed" />

                <!-- ============ terminal text ============ -->
                <TextBlock Text="{DynamicResource L_TerminalText}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource L_TerminalTextNote}"
                           Style="{StaticResource SectionNote}" />

                <Grid ColumnDefinitions="150,240,20,Auto" Margin="0,0,0,9">
                    <TextBlock Grid.Column="0" Text="{DynamicResource L_Font}" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="FontBox"
                              Grid.Column="1"
                              SelectionChanged="Font_SelectionChanged" />
                </Grid>

                <Grid ColumnDefinitions="150,110,20,150,110" Margin="0,0,0,9">
                    <TextBlock Grid.Column="0" Text="{DynamicResource L_Size}" Style="{StaticResource RowLabel}" />
                    <TextBox x:Name="FontSizeBox" Grid.Column="1" Padding="7,4"
                             TextChanged="FontSize_TextChanged" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource L_LineHeight}" Style="{StaticResource RowLabel}" />
                    <TextBox x:Name="LineHeightBox" Grid.Column="4" Padding="7,4"
                             TextChanged="LineHeight_TextChanged" />
                </Grid>

                <Grid ColumnDefinitions="150,240,20,Auto" Margin="0,0,0,9">
                    <TextBlock Grid.Column="0" Text="{DynamicResource L_Cursor}" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="CursorBox" Grid.Column="1" SelectionChanged="Cursor_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource L_CursorBar}" />
                        <ComboBoxItem Content="{DynamicResource L_CursorBlock}" />
                        <ComboBoxItem Content="{DynamicResource L_CursorUnderline}" />
                    </ComboBox>
                    <CheckBox x:Name="BlinkBox"
                              Grid.Column="3"
                              Content="{DynamicResource L_Blink}"
                              VerticalAlignment="Center"
                              Checked="Blink_Changed"
                              Unchecked="Blink_Changed" />
                </Grid>

                <Grid ColumnDefinitions="150,110" Margin="0,0,0,20">
                    <TextBlock Grid.Column="0" Text="{DynamicResource L_Scrollback}" Style="{StaticResource RowLabel}" />
                    <TextBox x:Name="ScrollbackBox" Grid.Column="1" Padding="7,4"
                             TextChanged="Scrollback_TextChanged" />
                </Grid>

                <!-- ============ background picture ============ -->
                <TextBlock Text="{DynamicResource L_BackgroundPicture}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource L_BackgroundPictureNote}"
                           Style="{StaticResource SectionNote}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="BgNone" Style="{StaticResource SegmentedRadio}"
                                 Content="{DynamicResource L_BgNone}" Margin="0,0,8,0" Checked="BackgroundMode_Changed" />
                    <RadioButton x:Name="BgWindow" Style="{StaticResource SegmentedRadio}"
                                 Content="{DynamicResource L_BgWindow}" Margin="0,0,8,0" Checked="BackgroundMode_Changed" />
                    <RadioButton x:Name="BgRegions" Style="{StaticResource SegmentedRadio}"
                                 Content="{DynamicResource L_BgRegions}" Margin="0,0,8,0" Checked="BackgroundMode_Changed" />
                    <RadioButton x:Name="BgLive" Style="{StaticResource SegmentedRadio}"
                                 Content="{DynamicResource L_BgLive}" Checked="BackgroundMode_Changed" />
                </StackPanel>

                <StackPanel x:Name="LivePanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource L_LiveNote}"
                               Style="{StaticResource SectionNote}" Margin="0,0,0,8" />
                    <Grid ColumnDefinitions="150,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_Layout}" Style="{StaticResource RowLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="WpAligned" Style="{StaticResource SegmentedRadio}"
                                         Content="{DynamicResource L_FollowDesktop}" Margin="0,0,8,0"
                                         Checked="WallpaperDisplay_Changed" />
                            <RadioButton x:Name="WpFit" Style="{StaticResource SegmentedRadio}"
                                         Content="{DynamicResource L_FitInsideWindow}"
                                         Checked="WallpaperDisplay_Changed" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource L_LayoutNote}"
                               Style="{StaticResource SectionNote}" Margin="150,0,0,10" />

                    <Grid ColumnDefinitions="150,200,10,90">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_FrameRate}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="FpsSlider" Grid.Column="1" Minimum="1" Maximum="120"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="Fps_Changed" />
                        <TextBlock x:Name="FpsText" Grid.Column="3" Style="{StaticResource RowLabel}" />
                    </Grid>
                    <TextBlock Text="{DynamicResource L_FrameNote}"
                               Style="{StaticResource SectionNote}" Margin="150,6,0,10" />

                    <TextBlock Text="{DynamicResource L_TrimNote}"
                               Style="{StaticResource SectionNote}" Margin="0,0,0,8" />
                    <Grid ColumnDefinitions="150,180,10,60" Margin="0,0,0,5">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_Left}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="CropLeftSlider" Grid.Column="1" Minimum="0" Maximum="0.45" ValueChanged="Crop_Changed" />
                        <TextBlock x:Name="CropLeftText" Grid.Column="3" Style="{StaticResource RowLabel}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,180,10,60" Margin="0,0,0,5">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_Right}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="CropRightSlider" Grid.Column="1" Minimum="0" Maximum="0.45" ValueChanged="Crop_Changed" />
                        <TextBlock x:Name="CropRightText" Grid.Column="3" Style="{StaticResource RowLabel}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,180,10,60" Margin="0,0,0,5">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_Top}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="CropTopSlider" Grid.Column="1" Minimum="0" Maximum="0.45" ValueChanged="Crop_Changed" />
                        <TextBlock x:Name="CropTopText" Grid.Column="3" Style="{StaticResource RowLabel}" />
                    </Grid>
                    <Grid ColumnDefinitions="150,180,10,60">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_Bottom}" Style="{StaticResource RowLabel}" />
                        <Slider x:Name="CropBottomSlider" Grid.Column="1" Minimum="0" Maximum="0.45" ValueChanged="Crop_Changed" />
                        <TextBlock x:Name="CropBottomText" Grid.Column="3" Style="{StaticResource RowLabel}" />
                    </Grid>
                </StackPanel>

                <ItemsControl x:Name="BackdropEditors" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceRaised}"
                                    BorderBrush="{DynamicResource Divider}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="14,12"
                                    Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{DynamicResource UiFont}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,9" />

                                    <Grid ColumnDefinitions="*,8,Auto,6,Auto" Margin="0,0,0,9" Visibility="{Binding ShowFilePicker, Converter={StaticResource BoolToVis}}">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11.5" Padding="7,5" />
                                        <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                                Content="{DynamicResource L_Browse}" Padding="12,6"
                                                Click="BrowseImage_Click" Tag="{Binding}" />
                                        <Button Grid.Column="4" Style="{StaticResource GhostButton}"
                                                Content="{DynamicResource L_Clear}" Padding="12,6"
                                                Click="ClearImage_Click" Tag="{Binding}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="120,180,10,Auto" Margin="0,0,0,7">
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L_Fit}" Style="{StaticResource RowLabel}" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedIndex="{Binding StretchIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource L_FitFillCrop}" />
                                            <ComboBoxItem Content="{DynamicResource L_FitInside}" />
                                            <ComboBoxItem Content="{DynamicResource L_FitStretch}" />
                                            <ComboBoxItem Content="{DynamicResource L_FitOriginal}" />
                                        </ComboBox>
                                    </Grid>

                                    <Grid ColumnDefinitions="120,180,10,60" Margin="0,0,0,5">
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L_PictureBlur}" Style="{StaticResource RowLabel}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="60"
                                                Value="{Binding ImageBlur, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ImageBlur, StringFormat={}{0:0}}"
                                                   Style="{StaticResource RowLabel}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="120,180,10,60" Margin="0,0,0,5">
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L_PictureOpacity}" Style="{StaticResource RowLabel}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                Value="{Binding ImageOpacity, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ImageOpacity, StringFormat={}{0:P0}}"
                                                   Style="{StaticResource RowLabel}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="120,Auto,10,110" Margin="0,9,0,5">
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L_OverlayColour}" Style="{StaticResource RowLabel}" />
                                        <Border Grid.Column="1" Width="30" Height="26" CornerRadius="5"
                                                Background="{Binding OverlaySwatch}"
                                                BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding OverlayColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                                 FontSize="11.5" Padding="7,4" />
                                    </Grid>

                                    <Grid ColumnDefinitions="120,180,10,60" Margin="0,0,0,5">
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L_OverlayOpacity}" Style="{StaticResource RowLabel}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                Value="{Binding OverlayOpacity, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="3" Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}"
                                                   Style="{StaticResource RowLabel}" />
                                    </Grid>

                                    <Grid ColumnDefinitions="120,180,10,60">
                                        <TextBlock Grid.Column="0" Text="{DynamicResource L_OverlayBlur}" Style="{StaticResource RowLabel}" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="60"
                                                Value="{Binding OverlayBlur, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="3" Text="{Binding OverlayBlur, StringFormat={}{0:0}}"
                                                   Style="{StaticResource RowLabel}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ============ window behaviour ============ -->
                <TextBlock Text="{DynamicResource L_Window}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource L_WindowNote}" Style="{StaticResource SectionNote}" />
                <CheckBox x:Name="AlwaysOnTopBox"
                          Content="{DynamicResource L_AlwaysOnTop}"
                          Margin="0,0,0,20"
                          Checked="AlwaysOnTop_Changed"
                          Unchecked="AlwaysOnTop_Changed" />

                <!-- ============ see-through ============ -->
                <TextBlock Text="{DynamicResource L_SeeThrough}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource L_SeeThroughNote}"
                           Style="{StaticResource SectionNote}" />

                <Grid ColumnDefinitions="150,200,10,60" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="{DynamicResource L_WholeWindow}" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="WindowOpacitySlider" Grid.Column="1" Minimum="0.2" Maximum="1"
                            ValueChanged="Opacity_Changed" />
                    <TextBlock x:Name="WindowOpacityText" Grid.Column="3" Style="{StaticResource RowLabel}" />
                </Grid>
                <Grid ColumnDefinitions="150,200,10,60" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="{DynamicResource L_Sidebar}" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="SidebarOpacitySlider" Grid.Column="1" Minimum="0" Maximum="1"
                            ValueChanged="Opacity_Changed" />
                    <TextBlock x:Name="SidebarOpacityText" Grid.Column="3" Style="{StaticResource RowLabel}" />
                </Grid>
                <Grid ColumnDefinitions="150,200,10,60" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="{DynamicResource L_TabBar}" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="TabBarOpacitySlider" Grid.Column="1" Minimum="0" Maximum="1"
                            ValueChanged="Opacity_Changed" />
                    <TextBlock x:Name="TabBarOpacityText" Grid.Column="3" Style="{StaticResource RowLabel}" />
                </Grid>
                <Grid ColumnDefinitions="150,200,10,60" Margin="0,0,0,20">
                    <TextBlock Grid.Column="0" Text="{DynamicResource L_Terminal}" Style="{StaticResource RowLabel}" />
                    <Slider x:Name="TerminalOpacitySlider" Grid.Column="1" Minimum="0" Maximum="1"
                            ValueChanged="Opacity_Changed" />
                    <TextBlock x:Name="TerminalOpacityText" Grid.Column="3" Style="{StaticResource RowLabel}" />
                </Grid>

                <!-- ============ terminal colours ============ -->
                <TextBlock Text="{DynamicResource L_TerminalColours}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource L_TerminalColoursNote}"
                           Style="{StaticResource SectionNote}" />
                <ItemsControl x:Name="TerminalColors" ItemTemplate="{StaticResource ColorRow}" Margin="0,0,0,20" />

                <!-- ============ ANSI palette ============ -->
                <TextBlock Text="{DynamicResource L_AnsiPalette}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource L_AnsiNote}"
                           Style="{StaticResource SectionNote}" />
                <ItemsControl x:Name="AnsiColors" ItemTemplate="{StaticResource ColorRow}" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- ============ application ============ -->
                <TextBlock Text="{DynamicResource L_Application}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{DynamicResource L_ApplicationNote}"
                           Style="{StaticResource SectionNote}" />

                <Grid ColumnDefinitions="150,240" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0" Text="{DynamicResource L_InterfaceFont}" Style="{StaticResource RowLabel}" />
                    <ComboBox x:Name="UiFontBox" Grid.Column="1" SelectionChanged="UiFont_SelectionChanged" />
                </Grid>

                <ItemsControl x:Name="AppColors" ItemTemplate="{StaticResource ColorRow}" />

                <!-- Room at the bottom so the floating preview never sits over the last rows. -->
                <Border Height="150" Background="Transparent" />
            </StackPanel>
        </ScrollViewer>

        <!-- ============ floating preview ============ -->
        <!-- Pinned bottom-right, over the scrolling settings, so the palette can be judged
             against the terminal while any control is in reach. Click-through, so it never
             blocks the settings underneath it. -->
        <Border Grid.Row="1"
                x:Name="FloatingPreview"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,24"
                MaxWidth="360"
                IsHitTestVisible="False"
                Background="{DynamicResource Chrome}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{DynamicResource L_Preview}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Border x:Name="PreviewSurface"
                        CornerRadius="7"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="1"
                        Padding="14,11">
                    <StackPanel x:Name="PreviewLines" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>



