<Window x:Class="RedBloom.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}"
        FontFamily="{DynamicResource UiFont}">
    <StackPanel Margin="16">
        <TextBlock x:Name="Note"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11.5"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <TextBox x:Name="Entry"
                 FontSize="13"
                 Padding="8,6"
                 KeyDown="Entry_KeyDown" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource L_Cancel}"
                    Style="{StaticResource GhostButton}"
                    Padding="14,6"
                    IsCancel="True" />
            <Button Content="{DynamicResource L_Save}"
                    Style="{StaticResource GhostButton}"
                    Padding="14,6"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="Accept_Click" />
        </StackPanel>
    </StackPanel>
</Window>
