<Window x:Class="RedBloom.Views.ChatNamesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L_AiRenameChat}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface}"
        FontFamily="{DynamicResource UiFont}">
    <StackPanel Margin="16">
        <TextBlock Text="{DynamicResource L_AiChatName}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11"
                   Margin="0,0,0,4" />
        <TextBox x:Name="TitleBox" FontSize="13" Padding="8,6" />
        <TextBlock Text="{DynamicResource L_AiChatNameNote}"
                   Foreground="{DynamicResource TextFaint}"
                   FontSize="10.5"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <TextBlock Text="{DynamicResource L_AiBotName}"
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="11"
                   Margin="0,14,0,4" />
        <TextBox x:Name="BotBox" FontSize="13" Padding="8,6" />
        <TextBlock Text="{DynamicResource L_AiBotNameNote}"
                   Foreground="{DynamicResource TextFaint}"
                   FontSize="10.5"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource L_Cancel}"
                    Style="{StaticResource GhostButton}"
                    Padding="14,6"
                    IsCancel="True" />
            <Button Content="{DynamicResource L_Save}"
                    Style="{StaticResource GhostButton}"
                    Padding="14,6"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    Click="Accept_Click" />
        </StackPanel>
    </StackPanel>
</Window>
