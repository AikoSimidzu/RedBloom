<Window x:Class="RedBloom.Views.PasswordPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Password"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource Chrome}"
            BorderBrush="{DynamicResource Divider}"
            BorderThickness="1"
            CornerRadius="9"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <StackPanel Margin="20,18,20,18">
            <TextBlock Text="Password required"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="TargetText"
                       Foreground="{DynamicResource TextMuted}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="11.5"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0" />

            <PasswordBox x:Name="PasswordField" Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource GhostButton}"
                        Content="Cancel"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Style="{StaticResource AccentButton}"
                        Content="Connect"
                        IsDefault="True"
                        Click="Connect_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

