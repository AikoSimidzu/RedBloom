<Window x:Class="RedBloom.Views.RoomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RedBloom"
        mc:Ignorable="d"
        Title="Room"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:HexToBrushConverter x:Key="HexToBrush" />
    </Window.Resources>

    <Border Background="{DynamicResource Chrome}"
            BorderBrush="{DynamicResource Divider}"
            BorderThickness="1"
            CornerRadius="9"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.6" Color="Black" />
        </Border.Effect>

        <StackPanel Margin="22,20,22,18">
            <TextBlock Text="{DynamicResource L_RoomTitle}"
                       Foreground="{DynamicResource TextPrimary}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14" />

            <TextBlock Text="{DynamicResource L_RoomName}"
                       Foreground="{DynamicResource TextMuted}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" Padding="7,5" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource L_RoomParticipants}"
                           Foreground="{DynamicResource TextMuted}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="{DynamicResource L_RoomAddModel}"
                        Style="{StaticResource GhostButton}"
                        Padding="9,3"
                        ToolTip="{DynamicResource L_RoomAddModelTip}"
                        Click="AddModel_Click" />
            </Grid>
            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,0,0,12">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AgentsList" Margin="8,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Chrome}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Chosen}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentDim}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding Chosen, Mode=TwoWay}"
                                              VerticalContentAlignment="Center"
                                              Foreground="{DynamicResource TextPrimary}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{DynamicResource UiFont}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Kind}"
                                                       Foreground="{DynamicResource TextFaint}"
                                                       FontFamily="{DynamicResource UiFont}"
                                                       FontSize="11"
                                                       Margin="8,1,0,0" />
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Per-agent identity, editable only for a chosen participant. Edits
                                         are held here and written back to the agent when the room is saved. -->
                                    <Grid Margin="24,6,4,2"
                                          ColumnDefinitions="58,*"
                                          Visibility="{Binding Chosen, Converter={StaticResource BoolToVis}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L_AiName}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontFamily="{DynamicResource UiFont}" FontSize="11.5"
                                                   VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Padding="6,3" Margin="0,0,0,4"
                                                 Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L_AiNameColor}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontFamily="{DynamicResource UiFont}" FontSize="11.5"
                                                   VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="26,6,*" Margin="0,0,0,4">
                                            <Border Grid.Column="0" Width="26" Height="24" CornerRadius="5"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="ColorSwatch_Click"
                                                    Background="{Binding NameColor, Converter={StaticResource HexToBrush}}"
                                                    BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                                            <TextBox Grid.Column="2" Padding="6,3"
                                                     FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11.5"
                                                     Text="{Binding NameColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L_AiAvatar}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontFamily="{DynamicResource UiFont}" FontSize="11.5"
                                                   VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding AvatarLabel}"
                                                       Foreground="{DynamicResource TextFaint}"
                                                       FontFamily="{DynamicResource UiFont}" FontSize="11.5"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Content="{DynamicResource L_Browse}"
                                                    Style="{StaticResource GhostButton}" Padding="9,3" Margin="6,0,0,0"
                                                    Click="BrowseAvatar_Click" />
                                            <Button Grid.Column="2" Content="{DynamicResource L_Clear}"
                                                    Style="{StaticResource GhostButton}" Padding="9,3" Margin="6,0,0,0"
                                                    Click="ClearAvatar_Click" />
                                        </Grid>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource L_AiModel}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontFamily="{DynamicResource UiFont}" FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding ModelEditable, Converter={StaticResource BoolToVis}}" />
                                        <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,0,4"
                                              Visibility="{Binding ModelEditable, Converter={StaticResource BoolToVis}}">
                                            <TextBox Grid.Column="0" Padding="6,3"
                                                     Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Grid.Column="1" Content="{DynamicResource L_AiPickModel}"
                                                    Style="{StaticResource GhostButton}" Padding="9,3" Margin="6,0,0,0"
                                                    Click="PickModel_Click" />
                                        </Grid>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource L_RoomContextPerTurn}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   FontFamily="{DynamicResource UiFont}" FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="0,0,0,4" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Padding="6,3" Margin="0,0,0,4"
                                                 Text="{Binding ContextWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Text="{DynamicResource L_RoomMode}"
                       Foreground="{DynamicResource TextMuted}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="12"
                       Margin="0,0,0,4" />
            <ComboBox x:Name="PolicyBox" Margin="0,0,0,4" SelectionChanged="Policy_Changed">
                <ComboBoxItem Content="{DynamicResource L_RoomPolicyMention}" />
                <ComboBoxItem Content="{DynamicResource L_RoomPolicyRoundRobin}" />
                <ComboBoxItem Content="{DynamicResource L_RoomPolicyAll}" />
                <ComboBoxItem Content="{DynamicResource L_RoomPolicyModerator}" />
            </ComboBox>
            <TextBlock x:Name="PolicyNote"
                       Foreground="{DynamicResource TextFaint}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <StackPanel x:Name="ModeratorRow" Margin="0,0,0,4">
                <TextBlock Text="{DynamicResource L_RoomModerator}"
                           Foreground="{DynamicResource TextMuted}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="12"
                           Margin="0,0,0,4" />
                <ComboBox x:Name="ModeratorBox">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{DynamicResource UiFont}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ShortModel}"
                                           Foreground="{DynamicResource TextFaint}"
                                           FontFamily="{DynamicResource UiFont}"
                                           FontSize="11"
                                           Margin="8,1,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <CheckBox x:Name="AllowCommandsBox"
                      Content="{DynamicResource L_RoomAllowCommands}"
                      Margin="0,10,0,0" />
            <TextBlock Text="{DynamicResource L_RoomAllowCommandsNote}"
                       Foreground="{DynamicResource TextFaint}"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="25,3,0,0" />
            <CheckBox x:Name="AskBeforeRunBox"
                      Content="{DynamicResource L_RoomAskBeforeRun}"
                      Margin="25,6,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{DynamicResource L_Cancel}"
                        Style="{StaticResource GhostButton}"
                        Padding="14,6"
                        Click="Cancel_Click" />
                <Button Content="{DynamicResource L_RoomOpen}"
                        Style="{StaticResource AccentButton}"
                        Padding="14,6"
                        Margin="8,0,0,0"
                        Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
