<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="SSH.NET" Version="2025.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />

    <!-- The native D3D capture hook, injected into Wallpaper Engine at runtime. Prebuilt from
         native\RedBloomHook; it ships next to the exe so the injector can find it by path. -->
    <Content Include="Native\RedBloomHook.dll" Link="RedBloomHook.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
