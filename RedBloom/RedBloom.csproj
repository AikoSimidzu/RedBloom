<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Enabled only for the tray icon's NotifyIcon. The implicit WinForms/Drawing usings are
         removed below so they cannot shadow WPF's Application, MessageBox, Clipboard and the
         like; the tray file names those types in full. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.40.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the global namespace WPF-first; the tray code qualifies WinForms explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.ico" />

    <!-- The native D3D capture hook, injected into Wallpaper Engine at runtime. Prebuilt from
         native\RedBloomHook; it ships next to the exe so the injector can find it by path. -->
    <Content Include="Native\RedBloomHook.dll" Link="RedBloomHook.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
