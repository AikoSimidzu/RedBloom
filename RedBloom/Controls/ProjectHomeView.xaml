<UserControl x:Class="RedBloom.Controls.ProjectHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="220" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- ==== header ==== -->
        <StackPanel Grid.Row="0">
            <TextBox x:Name="NameBox"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource Accent}"
                     FontFamily="{DynamicResource UiFont}" FontSize="21" FontWeight="SemiBold"
                     Padding="0" TextChanged="Name_Changed" />

            <TextBox x:Name="DescriptionBox"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TextMuted}" CaretBrush="{DynamicResource Accent}"
                     FontFamily="{DynamicResource UiFont}" FontSize="12.5"
                     Padding="0" Margin="0,5,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                     TextChanged="Description_Changed" />

            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,12,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" x:Name="FolderText" Foreground="{DynamicResource TextMuted}"
                               FontFamily="{DynamicResource UiFont}" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource Pill}"
                            Content="{DynamicResource L_ProjectOpenFolder}" Click="OpenFolder_Click" />
                </Grid>
            </Border>

            <!-- activity monitoring: filled in code-behind from ProjectStats -->
            <WrapPanel x:Name="StatsPanel" Orientation="Horizontal" Margin="0,12,0,0" />
        </StackPanel>

        <!-- ==== relationship tree (inline, expandable) ==== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
            <TextBlock Grid.Column="0" Text="{DynamicResource L_ProjectGraph}" Style="{StaticResource SectionHeader}" />
            <Button Grid.Column="1" Style="{StaticResource Pill}" Click="Graph_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" />
                    <TextBlock Text="{DynamicResource L_ProjectExpand}" />
                </StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="2" Margin="0,8,0,0"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <ContentControl x:Name="GraphHost" />
        </Border>

        <!-- ==== project info (Markdown, via the file editor) ==== -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
            <TextBlock Grid.Column="0" Text="{DynamicResource L_ProjectInfo}" Style="{StaticResource SectionHeader}" />
            <Button Grid.Column="1" Style="{StaticResource Pill}" Click="InfoExpand_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" />
                    <TextBlock Text="{DynamicResource L_ProjectExpand}" />
                </StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="4" Margin="0,8,0,0"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}"
                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <ContentControl x:Name="InfoHost" />
        </Border>
    </Grid>
</UserControl>
