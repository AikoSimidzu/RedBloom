<Window x:Class="RedBloom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:RedBloom"
        xmlns:models="clr-namespace:RedBloom.Models"
        xmlns:controls="clr-namespace:RedBloom.Controls"
        mc:Ignorable="d"
        Title="RedBloom" Height="620" Width="1040"
        MinHeight="360" MinWidth="720"
        WindowStyle="None"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <local:RemainingWidthConverter x:Key="RemainingWidth" />

        <!-- ===== a tab in the strip ===== -->
        <DataTemplate x:Key="TabTemplate" DataType="{x:Type local:TerminalTab}">
            <Border x:Name="TabRoot"
                    Background="{DynamicResource TabBacking}"
                    CornerRadius="6,6,0,0"
                    Margin="0,4,2,0"
                    Height="32"
                    MaxWidth="220"
                    ClipToBounds="True"
                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                    MouseDown="Tab_MouseDown"
                    MouseRightButtonUp="Tab_RightClick"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border.ToolTip>
                    <ToolTip Content="{Binding ToolTip}" />
                </Border.ToolTip>
                <Grid>
                    <!-- The card's own colour or picture, drawn behind the tab's label. Its blur
                         and translucency are its own; when it is present the plate above steps
                         aside (a trigger below) so this is what shows. -->
                    <Border x:Name="CardOverlay"
                            CornerRadius="6,6,0,0"
                            Background="{Binding CardBackground}"
                            Opacity="{Binding CardOpacity}"
                            Effect="{Binding CardBlur}"
                            Visibility="{Binding CardOverlayVisibility}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,6,0">
                    <TextBlock Grid.Column="0"
                               Text="{Binding CardGlyph}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFaint}"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />
                    <TextBlock x:Name="TabTitle"
                               Grid.Column="1"
                               Text="{Binding Title}"
                               Foreground="{DynamicResource TextMuted}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Content="&#xE711;"
                            FontSize="9"
                            Width="18"
                            Height="18"
                            Margin="6,0,0,0"
                            Click="CloseTab_Click"
                            Tag="{Binding}"
                            ToolTip="{DynamicResource L_CloseTabTip}" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TerminalFill}" />
                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TabRoot" Property="Opacity" Value="0.85" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding HasEnded}" Value="True">
                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextFaint}" />
                    <Setter TargetName="TabTitle" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <!-- A tab with its own colour or picture drops the shared plate so its own
                     translucency governs — last, so it wins over the selected state's fill. -->
                <DataTrigger Binding="{Binding HasCardBackground}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="Transparent" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== a saved SSH session in the sidebar ===== -->
        <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="9,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== one saved chat in the sidebar ===== -->
        <DataTemplate x:Key="ChatTemplate" DataType="{x:Type models:ChatSession}">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Background="Transparent"
                  MouseRightButtonUp="ChatList_RightClick">
                <Border Grid.Column="0"
                        Width="3" Height="26"
                        CornerRadius="2"
                        Background="{DynamicResource AccentDim}"
                        Margin="0,0,9,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}"
                               Foreground="{DynamicResource TextFaint}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="10.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Content="&#xE74D;"
                        FontSize="10"
                        Width="20" Height="20"
                        VerticalAlignment="Center"
                        Click="DeleteChat_Click"
                        Tag="{Binding}"
                        ToolTip="{DynamicResource L_AiDeleteChat}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type models:SshSession}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0"
                        Width="3" Height="26"
                        CornerRadius="2"
                        Background="{DynamicResource AccentDim}"
                        Margin="0,0,9,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DisplayTarget}"
                               Foreground="{DynamicResource TextFaint}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="10.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />
                    <TextBlock Text="{Binding ForwardSummary}"
                               Foreground="{DynamicResource AccentDim}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasForwards, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel x:Name="Actions"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Hidden">
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE70F;"
                            Width="22" Height="22"
                            Click="EditSession_Click"
                            Tag="{Binding}"
                            ToolTip="{DynamicResource L_Edit}" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE74D;"
                            Width="22" Height="22"
                            Click="DeleteSession_Click"
                            Tag="{Binding}"
                            ToolTip="{DynamicResource L_Delete}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="36,*">
        <Grid.ColumnDefinitions>
            <!-- One column drives both the brand strip and the sidebar, so collapsing it
                 slides the whole left edge as a single piece. -->
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Backdrops come first so everything else paints on top of them. -->
        <controls:BackdropHost x:Name="WindowBackdrop" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" />
        <controls:BackdropHost x:Name="SidebarBackdrop" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" />
        <controls:BackdropHost x:Name="TerminalBackdrop" Grid.Row="1" Grid.Column="1" />

        <!-- ============ brand / sidebar toggle ============ -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SidebarFill}" ClipToBounds="True">
            <StackPanel Orientation="Horizontal"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="SidebarToggle"
                        Style="{StaticResource IconButton}"
                        Content="&#xE700;"
                        Width="30" Height="28"
                        Click="ToggleSidebar_Click"
                        ToolTip="{DynamicResource L_CollapseSidebarTip}" />
                <!-- A drawn mark rather than a glyph, so it never depends on an icon font. -->
                <Ellipse x:Name="BrandDot"
                         Width="9" Height="9"
                         Fill="{DynamicResource Accent}"
                         VerticalAlignment="Center"
                         Margin="6,0,0,0" />
                <TextBlock x:Name="BrandText"
                           Text="RedBloom"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ============ title bar / tab strip ============ -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource TabBarFill}">
            <Grid ColumnDefinitions="*,Auto">

                <!-- tabs + new tab split button.
                     A Grid rather than a StackPanel: a horizontal StackPanel hands its children
                     infinite width, so the strip laid every tab out at full size and the ones
                     past the edge slid under the caption buttons and were clipped away, taking
                     the new-tab and split buttons with them. The star column bounds the strip so
                     the overflow scrolls instead, and the buttons keep a column of their own. -->
                <Grid x:Name="TabBar" Grid.Column="0" ColumnDefinitions="Auto,*">
                    <!-- The strip sizes to its tabs so the buttons stay flush against the last
                         one, capped at whatever the buttons leave it. Past that cap the tabs
                         share the width out between them instead of running off the edge. -->
                    <ItemsControl x:Name="TabStrip"
                                  Grid.Column="0"
                                  ItemsSource="{Binding Tabs}"
                                  ItemTemplate="{StaticResource TabTemplate}"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Left"
                                  PreviewMouseMove="TabStrip_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="TabStrip_PreviewMouseLeftButtonUp"
                                  LostMouseCapture="TabStrip_LostMouseCapture">
                        <ItemsControl.MaxWidth>
                            <MultiBinding Converter="{StaticResource RemainingWidth}">
                                <Binding ElementName="TabBar" Path="ActualWidth" />
                                <Binding ElementName="TabActions" Path="ActualWidth" />
                            </MultiBinding>
                        </ItemsControl.MaxWidth>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:TabStripPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel x:Name="TabActions"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="4,2,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="NewTabButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE710;"
                                Width="26" Height="26"
                                Click="NewTab_Click"
                                ToolTip="{DynamicResource L_NewTabTip}" />
                        <Button x:Name="ShellMenuButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE70D;"
                                FontSize="9"
                                Width="18" Height="26"
                                Click="ShellMenu_Click"
                                ToolTip="{DynamicResource L_ChooseShell}" />

                        <!-- Add a split to the current tab: same SSH connection, or a new session. -->
                        <Button x:Name="SplitSameButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE8A9;"
                                FontSize="12"
                                Width="26" Height="26"
                                Margin="2,0,0,0"
                                Click="SplitSame_Click"
                                ToolTip="{DynamicResource L_SplitSameTip}" />
                        <Button x:Name="SplitNewButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE8AD;"
                                FontSize="12"
                                Width="26" Height="26"
                                Click="SplitNew_Click"
                                ToolTip="{DynamicResource L_SplitNewTip}" />
                    </StackPanel>
                </Grid>

                <!-- caption buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="TrayButton"
                            Style="{StaticResource CaptionButton}"
                            Content="&#xE896;"
                            FontSize="12"
                            Click="MinimizeToTray_Click"
                            ToolTip="{DynamicResource L_MinimizeToTray}" />
                    <Button Style="{StaticResource CaptionButton}"
                            Content="&#xE921;"
                            Click="Minimize_Click"
                            ToolTip="{DynamicResource L_Minimize}" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButton}"
                            Content="&#xE922;"
                            Click="MaximizeRestore_Click"
                            ToolTip="{DynamicResource L_Maximize}" />
                    <Button Style="{StaticResource CloseCaptionButton}"
                            Content="&#xE8BB;"
                            Click="Close_Click"
                            ToolTip="{DynamicResource L_Close}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ sidebar: saved SSH sessions ============ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource SidebarFill}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <!-- Held at its full width and clipped by the border, so the contents slide out of
                 view instead of reflowing into a narrower layout on every animation frame. -->
            <Grid x:Name="SidebarContent"
                  Width="220"
                  HorizontalAlignment="Left"
                  RowDefinitions="Auto,*">

                <!-- Which half of the sidebar is showing. Saved connections and saved chats are
                     both lists of things to open, but they have nothing to say to each other,
                     so they take turns rather than sharing the column. -->
                <Border Grid.Row="0"
                        Margin="12,12,12,8"
                        Background="{DynamicResource Chrome}"
                        CornerRadius="6"
                        Padding="2">
                    <Grid ColumnDefinitions="*,*">
                        <RadioButton x:Name="SshModeButton"
                                     Grid.Column="0"
                                     Style="{StaticResource SegmentedRadio}"
                                     Content="SSH"
                                     IsChecked="True"
                                     Checked="SidebarMode_Changed" />
                        <RadioButton x:Name="AiModeButton"
                                     Grid.Column="1"
                                     Style="{StaticResource SegmentedRadio}"
                                     Content="AI"
                                     Checked="SidebarMode_Changed" />
                    </Grid>
                </Border>

                <Grid x:Name="SshPanel" Grid.Row="1" RowDefinitions="Auto,Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,12,8,6">
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L_SshSessions}"
                               Foreground="{DynamicResource TextFaint}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Content="&#xE710;"
                            Width="22" Height="22"
                            Click="AddSession_Click"
                            ToolTip="{DynamicResource L_NewSshSession}" />
                </Grid>

                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <TextBox x:Name="SessionFilter"
                             Padding="8,5"
                             FontSize="11.5"
                             TextChanged="SessionFilter_TextChanged" />
                    <TextBlock x:Name="FilterHint"
                               Text="{DynamicResource L_FilterHint}"
                               Foreground="{DynamicResource TextFaint}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11.5"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox x:Name="SessionList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding SessionsView}"
                             ItemTemplate="{StaticResource SessionTemplate}"
                             ItemContainerStyle="{StaticResource SessionItemStyle}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="SessionList_MouseDoubleClick"
                             KeyDown="SessionList_KeyDown" />

                    <StackPanel VerticalAlignment="Center"
                                Margin="24,0"
                                IsHitTestVisible="False"
                                Visibility="{Binding HasNoSessions, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource L_NoSavedSessions}"
                                   Foreground="{DynamicResource TextFaint}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11.5"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L_UsePlusToAdd}"
                                   Foreground="{DynamicResource TextFaint}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="10.5"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
                </Grid>

                <!-- ==== AI: pick an agent, then its chats ==== -->
                <Grid x:Name="AiPanel"
                      Grid.Row="1"
                      RowDefinitions="Auto,Auto,*"
                      Visibility="Collapsed">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,12,8,6">
                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource L_AiChats}"
                                   Foreground="{DynamicResource TextFaint}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButton}"
                                Content="&#xE710;"
                                Width="22" Height="22"
                                Click="NewChat_Click"
                                ToolTip="{DynamicResource L_AiNewChat}" />
                    </Grid>

                    <!-- An explicit item template rather than DisplayMemberPath: the combo box
                         here wears a hand-written control template, and the template the path
                         generates does not reach its selection box. -->
                    <ComboBox x:Name="AgentPicker"
                              Grid.Row="1"
                              Margin="12,0,12,8"
                              SelectionChanged="AgentPicker_Changed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AiAgent}">
                                <TextBlock Text="{Binding PickerName}"
                                           FontFamily="{DynamicResource UiFont}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="ChatList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemTemplate="{StaticResource ChatTemplate}"
                                 ItemContainerStyle="{StaticResource SessionItemStyle}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="ChatList_MouseDoubleClick"
                                 KeyDown="ChatList_KeyDown" />

                        <StackPanel x:Name="NoChats"
                                    VerticalAlignment="Center"
                                    Margin="24,0"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource L_AiNoChats}"
                                       Foreground="{DynamicResource TextFaint}"
                                       FontFamily="{DynamicResource UiFont}"
                                       FontSize="11.5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ terminal surface ============ -->
        <!-- The terminal fills the whole cell and keeps its own fill; the split content inside
             is what is held clear of the window's right and bottom resize borders (see
             AddTerminalTab). That way the resize grip is reachable — the WebView2 child window
             would otherwise swallow the mouse there — while the exposed strip carries the same
             terminal fill as the rest, rather than the bare background picture. -->
        <Grid x:Name="TerminalHost" Grid.Row="1" Grid.Column="1" Background="{DynamicResource TerminalFill}">
            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="&#xE756;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="34"
                           Foreground="{DynamicResource TextFaint}"
                           HorizontalAlignment="Center"
                           Opacity="0.5" />
                <TextBlock Text="{DynamicResource L_NoOpenTerminals}"
                           Foreground="{DynamicResource TextMuted}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
                <TextBlock Text="{DynamicResource L_EmptyHint}"
                           Foreground="{DynamicResource TextFaint}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============ shell picker ============ -->
        <Popup x:Name="ShellPopup"
               PlacementTarget="{Binding ElementName=ShellMenuButton}"
               Placement="Bottom"
               VerticalOffset="4"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource Chrome}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="4"
                    Margin="0,0,10,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                <ItemsControl ItemsSource="{Binding ShellProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="ShellProfile_Click"
                                    Tag="{Binding}"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="10,7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" MinWidth="170">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Width="20" />
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{DynamicResource UiFont}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1"
                        Background="{DynamicResource Divider}"
                        Margin="8,4" />

                <Button Click="Settings_Click" Cursor="Hand" HorizontalContentAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,7">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" MinWidth="170">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Width="20" />
                        <TextBlock Text="{DynamicResource L_Settings}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="AiSettings_Click" Cursor="Hand" HorizontalContentAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,7">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" MinWidth="170">
                        <TextBlock Text="&#xE99A;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Width="20" />
                        <TextBlock Text="{DynamicResource L_AiSettings}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Click="LocalModels_Click" Cursor="Hand" HorizontalContentAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,7">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" MinWidth="170">
                        <TextBlock Text="&#xE964;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Width="20" />
                        <TextBlock Text="{DynamicResource L_LocalModels}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Only shown when the app is not already elevated. -->
                <Button x:Name="ElevateMenuButton" Click="Elevate_Click" Cursor="Hand"
                        HorizontalContentAlignment="Left" Visibility="Collapsed">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,7">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" MinWidth="170">
                        <TextBlock Text="&#xE7EF;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center"
                                   Width="20" />
                        <TextBlock Text="{DynamicResource L_ElevateNow}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============ tab card editor (right-click a tab) ============ -->
        <Popup x:Name="TabCardPopup"
               Placement="Bottom"
               VerticalOffset="2"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="TabCardPopup_Closed">
            <Border Background="{DynamicResource Chrome}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,10,10"
                    Width="290">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L_TabCard}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="13"
                               FontWeight="SemiBold" />

                    <!-- Only a chat has a name of its own to edit; a session tab is named by
                         the session and a quick connection by its host. -->
                    <StackPanel x:Name="CardNameRow" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource L_AiChatName}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11"
                                   Margin="0,12,0,4" />
                        <TextBox x:Name="CardNameBox"
                                 FontFamily="{DynamicResource UiFont}"
                                 FontSize="12" Padding="7,4"
                                 KeyDown="CardName_KeyDown" />

                        <TextBlock Text="{DynamicResource L_AiBotName}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11"
                                   Margin="0,10,0,4" />
                        <TextBox x:Name="CardBotBox"
                                 FontFamily="{DynamicResource UiFont}"
                                 FontSize="12" Padding="7,4"
                                 KeyDown="CardName_KeyDown" />
                        <TextBlock Text="{DynamicResource L_AiBotNameNote}"
                                   Foreground="{DynamicResource TextFaint}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Only a chat has an avatar, so this row is shown when the card being
                         edited belongs to one and hidden for tabs that do not. -->
                    <StackPanel x:Name="CardAvatarRow" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource L_AiChatAvatar}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11"
                                   Margin="0,12,0,4" />
                        <Grid ColumnDefinitions="*,6,Auto,6,Auto">
                            <TextBox Grid.Column="0"
                                     x:Name="CardAvatarBox"
                                     FontFamily="Cascadia Mono, Consolas, monospace"
                                     FontSize="11.5" Padding="7,4" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource L_Browse}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="9,4"
                                    Click="CardAvatarBrowse_Click" />
                            <Button Grid.Column="4"
                                    Content="{DynamicResource L_Clear}"
                                    Style="{StaticResource GhostButton}"
                                    Padding="9,4"
                                    Click="CardAvatarClear_Click" />
                        </Grid>
                        <TextBlock Text="{DynamicResource L_AiChatAvatarNote}"
                                   Foreground="{DynamicResource TextFaint}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Text="{DynamicResource L_CardColor}"
                               Foreground="{DynamicResource TextMuted}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11"
                               Margin="0,12,0,4" />
                    <Grid ColumnDefinitions="*,8,30">
                        <TextBox Grid.Column="0"
                                 Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 FontSize="11.5" Padding="7,4" />
                        <Border Grid.Column="2" Width="30" Height="26" CornerRadius="5"
                                Cursor="Hand"
                                MouseLeftButtonUp="TabCardSwatch_Click"
                                Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                BorderBrush="{DynamicResource Divider}" BorderThickness="1" />
                    </Grid>

                    <Grid ColumnDefinitions="*,46" Margin="0,12,0,0">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_CardOpacity}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontFamily="{DynamicResource UiFont}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Opacity, StringFormat={}{0:P0}}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontFamily="{DynamicResource UiFont}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" Margin="0,2,0,0" />

                    <Grid ColumnDefinitions="*,46" Margin="0,10,0,0">
                        <TextBlock Grid.Column="0" Text="{DynamicResource L_CardBlur}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontFamily="{DynamicResource UiFont}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Blur, StringFormat={}{0:0}}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontFamily="{DynamicResource UiFont}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Slider Minimum="0" Maximum="60" Value="{Binding Blur, Mode=TwoWay}" Margin="0,2,0,0" />

                    <TextBlock Text="{DynamicResource L_CardImage}"
                               Foreground="{DynamicResource TextMuted}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11"
                               Margin="0,12,0,4" />
                    <Grid ColumnDefinitions="*,6,Auto,6,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 FontSize="11.5" Padding="7,4" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource L_Browse}"
                                Style="{StaticResource GhostButton}"
                                Padding="9,4"
                                Click="CardImageBrowse_Click" />
                        <Button Grid.Column="4"
                                Content="{DynamicResource L_Clear}"
                                Style="{StaticResource GhostButton}"
                                Padding="9,4"
                                Click="CardImageClear_Click" />
                    </Grid>

                    <!-- Bound to the stretch name itself rather than to an index, so the list can
                         be reordered without silently changing what each row means. -->
                    <ComboBox Margin="0,6,0,0"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding Stretch, Mode=TwoWay}">
                        <ComboBoxItem Tag="UniformToFill" Content="{DynamicResource L_FitFillCrop}" />
                        <ComboBoxItem Tag="Uniform" Content="{DynamicResource L_FitInside}" />
                        <ComboBoxItem Tag="Fill" Content="{DynamicResource L_FitStretch}" />
                        <ComboBoxItem Tag="None" Content="{DynamicResource L_FitOriginal}" />
                    </ComboBox>

                    <Button Style="{StaticResource GhostButton}"
                            Content="{DynamicResource L_CardReset}"
                            HorizontalAlignment="Left"
                            Padding="12,5"
                            Margin="0,14,0,0"
                            Click="TabCardReset_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- Bottom-left toast: offers to save a quick-connect session, then fades over ~10s.
             Hovering it brings it back to full; it never steals focus from the terminal. -->
        <Border x:Name="SaveToast"
                Grid.Row="1" Grid.Column="1"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,20"
                MaxWidth="300"
                Visibility="Collapsed"
                Background="{DynamicResource Chrome}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="14,12"
                MouseEnter="SaveToast_MouseEnter"
                MouseLeave="SaveToast_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="SaveToastText"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="12.5"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="SaveToastButtons" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="SaveToastAction"
                            Style="{StaticResource GhostButton}"
                            Content="{DynamicResource L_Save}"
                            Padding="14,5"
                            Click="SaveToastAction_Click" />
                    <Button Style="{StaticResource GhostButton}"
                            Content="{DynamicResource L_Dismiss}"
                            Padding="12,5"
                            Margin="8,0,0,0"
                            Click="SaveToastDismiss_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>




