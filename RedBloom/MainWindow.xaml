<Window x:Class="RedBloom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:RedBloom"
        xmlns:models="clr-namespace:RedBloom.Models"
        xmlns:controls="clr-namespace:RedBloom.Controls"
        mc:Ignorable="d"
        Title="RedBloom" Height="620" Width="1040"
        MinHeight="360" MinWidth="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ===== a tab in the strip ===== -->
        <DataTemplate x:Key="TabTemplate" DataType="{x:Type local:TerminalTab}">
            <Border x:Name="TabRoot"
                    Background="{DynamicResource TabBacking}"
                    CornerRadius="6,6,0,0"
                    Margin="0,4,2,0"
                    Padding="10,0,6,0"
                    Height="32"
                    MinWidth="120"
                    MaxWidth="220"
                    MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                    MouseDown="Tab_MouseDown"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Border.ToolTip>
                    <ToolTip Content="{Binding ToolTip}" />
                </Border.ToolTip>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Glyph}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFaint}"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0" />
                    <TextBlock x:Name="TabTitle"
                               Grid.Column="1"
                               Text="{Binding Title}"
                               Foreground="{DynamicResource TextMuted}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Content="&#xE711;"
                            FontSize="9"
                            Width="18"
                            Height="18"
                            Margin="6,0,0,0"
                            Click="CloseTab_Click"
                            Tag="{Binding}"
                            ToolTip="{DynamicResource L_CloseTabTip}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TerminalFill}" />
                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TabRoot" Property="Opacity" Value="0.85" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding HasEnded}" Value="True">
                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextFaint}" />
                    <Setter TargetName="TabTitle" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== a saved SSH session in the sidebar ===== -->
        <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="5"
                                Padding="9,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type models:SshSession}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0"
                        Width="3" Height="26"
                        CornerRadius="2"
                        Background="{DynamicResource AccentDim}"
                        Margin="0,0,9,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DisplayTarget}"
                               Foreground="{DynamicResource TextFaint}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="10.5"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0" />
                    <TextBlock Text="{Binding ForwardSummary}"
                               Foreground="{DynamicResource AccentDim}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasForwards, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel x:Name="Actions"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="Hidden">
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE70F;"
                            Width="22" Height="22"
                            Click="EditSession_Click"
                            Tag="{Binding}"
                            ToolTip="{DynamicResource L_Edit}" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE74D;"
                            Width="22" Height="22"
                            Click="DeleteSession_Click"
                            Tag="{Binding}"
                            ToolTip="{DynamicResource L_Delete}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="36,*">
        <Grid.ColumnDefinitions>
            <!-- One column drives both the brand strip and the sidebar, so collapsing it
                 slides the whole left edge as a single piece. -->
            <ColumnDefinition x:Name="SidebarColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Backdrops come first so everything else paints on top of them. -->
        <controls:BackdropHost x:Name="WindowBackdrop" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" />
        <controls:BackdropHost x:Name="SidebarBackdrop" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" />
        <controls:BackdropHost x:Name="TerminalBackdrop" Grid.Row="1" Grid.Column="1" />

        <!-- ============ brand / sidebar toggle ============ -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SidebarFill}" ClipToBounds="True">
            <StackPanel Orientation="Horizontal"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="SidebarToggle"
                        Style="{StaticResource IconButton}"
                        Content="&#xE700;"
                        Width="30" Height="28"
                        Click="ToggleSidebar_Click"
                        ToolTip="{DynamicResource L_CollapseSidebarTip}" />
                <!-- A drawn mark rather than a glyph, so it never depends on an icon font. -->
                <Ellipse x:Name="BrandDot"
                         Width="9" Height="9"
                         Fill="{DynamicResource Accent}"
                         VerticalAlignment="Center"
                         Margin="6,0,0,0" />
                <TextBlock x:Name="BrandText"
                           Text="RedBloom"
                           Foreground="{DynamicResource TextPrimary}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ============ title bar / tab strip ============ -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource TabBarFill}">
            <Grid ColumnDefinitions="*,Auto">

                <!-- tabs + new tab split button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <ItemsControl x:Name="TabStrip"
                                  ItemsSource="{Binding Tabs}"
                                  ItemTemplate="{StaticResource TabTemplate}"
                                  VerticalAlignment="Bottom"
                                  PreviewMouseMove="TabStrip_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="TabStrip_PreviewMouseLeftButtonUp"
                                  LostMouseCapture="TabStrip_LostMouseCapture">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="4,2,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="NewTabButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE710;"
                                Width="26" Height="26"
                                Click="NewTab_Click"
                                ToolTip="{DynamicResource L_NewTabTip}" />
                        <Button x:Name="ShellMenuButton"
                                Style="{StaticResource IconButton}"
                                Content="&#xE70D;"
                                FontSize="9"
                                Width="18" Height="26"
                                Click="ShellMenu_Click"
                                ToolTip="{DynamicResource L_ChooseShell}" />
                    </StackPanel>
                </StackPanel>

                <!-- caption buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}"
                            Content="&#xE921;"
                            Click="Minimize_Click"
                            ToolTip="{DynamicResource L_Minimize}" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButton}"
                            Content="&#xE922;"
                            Click="MaximizeRestore_Click"
                            ToolTip="{DynamicResource L_Maximize}" />
                    <Button Style="{StaticResource CloseCaptionButton}"
                            Content="&#xE8BB;"
                            Click="Close_Click"
                            ToolTip="{DynamicResource L_Close}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ sidebar: saved SSH sessions ============ -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource SidebarFill}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True">
            <!-- Held at its full width and clipped by the border, so the contents slide out of
                 view instead of reflowing into a narrower layout on every animation frame. -->
            <Grid x:Name="SidebarContent"
                  Width="220"
                  HorizontalAlignment="Left"
                  RowDefinitions="Auto,Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="14,12,8,6">
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource L_SshSessions}"
                               Foreground="{DynamicResource TextFaint}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Content="&#xE710;"
                            Width="22" Height="22"
                            Click="AddSession_Click"
                            ToolTip="{DynamicResource L_NewSshSession}" />
                </Grid>

                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <TextBox x:Name="SessionFilter"
                             Padding="8,5"
                             FontSize="11.5"
                             TextChanged="SessionFilter_TextChanged" />
                    <TextBlock x:Name="FilterHint"
                               Text="{DynamicResource L_FilterHint}"
                               Foreground="{DynamicResource TextFaint}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="11.5"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox x:Name="SessionList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding SessionsView}"
                             ItemTemplate="{StaticResource SessionTemplate}"
                             ItemContainerStyle="{StaticResource SessionItemStyle}"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="SessionList_MouseDoubleClick"
                             KeyDown="SessionList_KeyDown" />

                    <StackPanel VerticalAlignment="Center"
                                Margin="24,0"
                                IsHitTestVisible="False"
                                Visibility="{Binding HasNoSessions, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource L_NoSavedSessions}"
                                   Foreground="{DynamicResource TextFaint}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="11.5"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource L_UsePlusToAdd}"
                                   Foreground="{DynamicResource TextFaint}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="10.5"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ terminal surface ============ -->
        <Grid x:Name="TerminalHost" Grid.Row="1" Grid.Column="1" Background="{DynamicResource TerminalFill}">
            <StackPanel x:Name="EmptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="&#xE756;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="34"
                           Foreground="{DynamicResource TextFaint}"
                           HorizontalAlignment="Center"
                           Opacity="0.5" />
                <TextBlock Text="{DynamicResource L_NoOpenTerminals}"
                           Foreground="{DynamicResource TextMuted}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
                <TextBlock Text="{DynamicResource L_EmptyHint}"
                           Foreground="{DynamicResource TextFaint}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============ shell picker ============ -->
        <Popup x:Name="ShellPopup"
               PlacementTarget="{Binding ElementName=ShellMenuButton}"
               Placement="Bottom"
               VerticalOffset="4"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="{DynamicResource Chrome}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="4"
                    Margin="0,0,10,10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                <ItemsControl ItemsSource="{Binding ShellProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="ShellProfile_Click"
                                    Tag="{Binding}"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Root"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="10,7">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" MinWidth="170">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"
                                               Width="20" />
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{DynamicResource UiFont}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1"
                        Background="{DynamicResource Divider}"
                        Margin="8,4" />

                <Button Click="Settings_Click" Cursor="Hand" HorizontalContentAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="10,7">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource ChromeHover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" MinWidth="170">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Width="20" />
                        <TextBlock Text="{DynamicResource L_Settings}"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="{DynamicResource UiFont}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>




